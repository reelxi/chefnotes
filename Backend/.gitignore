# Compiled output directories (generated by build tools)
/dist
/node_modules
/build

# Log files and debugging output
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS-specific files (e.g., macOS)
.DS_Store

# Test coverage and output directories
/coverage
/.nyc_output

# IDE and editor-specific settings
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VSCode IDE files (except shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment variables and secrets (dotenv)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Temporary directories and files
.temp
.tmp

# Runtime data and process IDs
pids
*.pid
*.seed
*.pid.lock

# Diagnostic and performance reports (Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
